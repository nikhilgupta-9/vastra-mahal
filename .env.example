# The Vastra Mahal - Environment Configuration File Example
# Copy this file to .env on your production server if you prefer .env over db.custom.php
# (Note: .env is in .gitignore, so Git will NEVER overwrite it during git pull / git push!)

APP_ENV=production

# Database Credentials for Live Server
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_live_db_user
DB_PASS=your_live_db_password
DB_NAME=your_live_db_name
